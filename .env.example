# Kakushi on Arc: every variable the repo reads. Copy to .env.local (gitignored) where noted. Never commit real keys.

# --- shared -------------------------------------------------------------------------------------------------
# testnet (chain 5042002, default) or mainnet (chain 5042)
KAKUSHI_NETWORK=testnet
# RPC override (a local Arc Foundry fork, or a private provider key). Default: the public Arc endpoint.
# ARC_RPC_URL=http://127.0.0.1:9200

# --- deploy (scripts/deploy.sh) ---------------------------------------------------------------------------------
# Either export DEPLOYER_PRIVATE_KEY, or point DEPLOYER_ENV_FILE at a file with a DEPLOYER_PRIVATE_KEY=0x... line.
# The key is read from the file inside the script and passed to forge through the environment, never argv.
# DEPLOYER_ENV_FILE=/path/to/deployer.env
# Required for mainnet: CONFIRM_MAINNET=yes
# Optional shared lock when several deploys use one wallet: DEPLOY_LOCK_DIR=/path/to/lock

# --- relayer (packages/relayer) -----------------------------------------------------------------------------------
# A separate hot wallet that only holds a little USDC for gas. Not the deployer.
# RELAYER_KEY=0x...            or RELAYER_KEY_FILE=/path/to/file containing RELAYER_KEY=0x...
RELAYER_PORT=3715
RELAYER_HOST=127.0.0.1
RELAYER_MIN_FEE=10000          # USDC base units (6 decimals): 0.01 USDC
RELAYER_MAX_FEE_BPS=3000       # do not offer a pool where the fee exceeds 30% of the note
RELAYER_QUOTE_GAS=4300000      # a withdrawal measures about 3.65M gas on Arc
RELAYER_ALLOW_ORIGIN=*

# --- web app (packages/app, Vercel) -----------------------------------------------------------------------------
# Where the app proxies /api/relayer/* to (the relayer above, behind TLS).
# KAKUSHI_RELAYER_URL=https://relayer.example.com
# Use another deployment record (path from the repo root), e.g. for a fork demo:
# KAKUSHI_DEPLOYMENT_FILE=deployments/arc-testnet.fork.json
# PORT=9210
